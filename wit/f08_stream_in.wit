package plexus:media@0.0.1;

// In the IR and not in WIT: a stream in.
/// A stream in: `Input<T>` is what the caller sends while the call runs.
/// It is not one of the parameters.
interface media {
  record kept {
    sha256: string,
    bytes: u64,
  }

  /// Keep a file. The caller streams its bytes in.
  put: func(name: string) -> kept;
  /// Count a run's tokens: a stream in of a type of its own.
  tokens: func(run: string) -> u32;
}

world media-activation {
  export media;
}
